pipeline {
  agent {
    docker {
      image 'abhishekf5/maven-abhishek-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        //git branch: 'main', url: 'https://github.com/iam-veeramalla/Jenkins-Zero-To-Hero.git'
      }
    }
   
  stage('Check Java and Maven') {
    steps {
        sh 'java -version'
        sh 'mvn -version'
        sh 'docker --version'
     }
   }

    stage('Build and Test') {
      steps {
        // sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://3.108.54.94:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
         sh '''
            # 1. Install Java 17 silently
            export DEBIAN_FRONTEND=noninteractive
            apt-get update -y
            apt-get install -y openjdk-17-jdk

            # 2. Tell the system to use Java 17 for the next command
            # Line 1 tells the system where Java 17 lives, and Line 2 forces the system to actually use it for the rest of this step.
            # Creates a global reference variable that tells other programs (like SonarQube or Maven) exactly where the Java 17 installation folder is located.
            export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
            # Adds the Java 17 bin folder (where the actual run commands live) to the very front of the system's command search list.
            export PATH=$JAVA_HOME/bin:$PATH
            
            # 3. Run the Sonar scanner (using the default sonar:sonar command)
            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
            mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}
          '''
        }
      }
    }
    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "nikhilb619/ultimate-cicd:${BUILD_NUMBER}"
        // DOCKERFILE_LOCATION = "java-maven-sonar-argocd-helm-k8s/spring-boot-app/Dockerfile"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
            sh '''
                # 1. Download and install a modern version of the Docker CLI
                curl -fsSLO https://download.docker.com/linux/static/stable/x86_64/docker-26.0.0.tgz
                tar xzvf docker-26.0.0.tgz
                cp docker/docker $(which docker)
                
                # 2. Build the Docker Image
                cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                docker build -t ${DOCKER_IMAGE} .
            '''
            
            // 3. Push the image to DockerHub
            def dockerImage = docker.image("${DOCKER_IMAGE}")
            docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                dockerImage.push()
            }
        }
      }
    }
    stage('Update Deployment File') {
        environment {
            GIT_REPO_NAME = "Jenkins"
            GIT_USER_NAME = "BaleNikhil01"
        }
        steps {
            withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                sh '''
                    git config user.email "nikhilb.xyz@gmail.com"
                    git config user.name "Nikhil Bale"
                    BUILD_NUMBER=${BUILD_NUMBER}
                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                    git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                '''
            }
        }
    }
  }
}
